    { "op": "set", "path": "dealEscrows/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee/actions/accept_1", "data": { "action": "accept", "actor": "$Creator", "expectedVersion": 1, "at": 1800000000 } },
    { "op": "set", "path": "sponsorDeals/deal_eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "data": { "status": "proof_submitted", "proofUrl": "https://example.com/proof", "proofAt": 1800000000 } },
    { "op": "as", "who": "Agent" },
    { "op": "set", "path": "sponsorDeals/deal_eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "data": { "verdictReason": "Checking the photos against the brief." } },
    { "op": "set", "path": "sponsorDeals/deal_eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "data": { "proofUrl": "https://example.com/other" }, "shouldFail": true },
    { "op": "as", "who": "Sponsor" },
    { "op": "set", "path": "dealEscrows/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee/actions/dispute_2", "data": { "action": "dispute", "actor": "$Sponsor", "expectedVersion": 2, "at": 1800000000, "reason": "The photos are not from the event." } },
    { "op": "as", "who": "Agent" },
    { "op": "set", "path": "sponsorDeals/deal_eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "data": { "status": "released", "settledAt": 1800000000 }, "shouldFail": true },
    { "op": "set", "path": "sponsorDeals/deal_eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "data": { "status": "disputed" } },
    { "op": "set", "path": "dealEscrows/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee/actions/resolve_3", "data": { "action": "resolve", "actor": "$Agent", "expectedVersion": 3, "at": 1800000000, "outcome": "refund" } },
    { "op": "expect", "expr": "get(/dealEscrows/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee).status == 'refunded'" },
    { "op": "set", "path": "sponsorDeals/deal_eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "data": { "status": "released", "settledAt": 1800000000 }, "shouldFail": true },
    { "op": "set", "path": "sponsorDeals/deal_eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "data": { "status": "refunded", "settledAt": 1800000001 }, "shouldFail": true },
    { "op": "set", "path": "sponsorDeals/deal_eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "data": { "status": "refunded", "settledAt": 1800000000 } },
    { "op": "expect", "expr": "get(/sponsorDeals/deal_eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee).status == 'refunded' && get(/sponsorDeals/deal_eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee).settledAt == 1800000000" },
    { "op": "set", "path": "sponsorDeals/deal_eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "data": { "status": "funded", "settledAt": null }, "shouldFail": true },
    { "op": "as", "who": "Outsider" },
    { "op": "set", "path": "sponsorDeals/deal_eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "data": { "status": "released", "settledAt": 1800000000 }, "shouldFail": true },
    { "op": "as", "who": "Sponsor" },
    { "op": "set", "path": "sponsorDeals/deal_99999999999999999999999999999999", "data": { "sponsor": "$Sponsor", "sponsorId": "$Sponsor", "creator": "$Creator", "listingId": "l1", "headline": "Hat at Breakpoint", "brief": "Wear the hat all day and post three photos.", "amountUsdc": 50000000, "challengeSeconds": 86400, "expiresAt": 1801814400, "deadline": 1800604800, "createdAt": 1800000000, "status": "awaiting_funding" } },
    { "op": "set", "path": "dealEscrows/99999999999999999999999999999999", "data": { "funder": "$Sponsor", "payee": "$Outsider", "amountUsdc": 50000000, "expiresAt": 1801814400, "ref": "deal_99999999999999999999999999999999", "createdAt": 1800000000, "status": "unfunded", "version": 0 } },
    { "op": "set", "path": "sponsorDeals/deal_99999999999999999999999999999999", "data": { "escrowId": "99999999999999999999999999999999", "rootAppId": "68652cfd2a7212f59461a789" } },
    { "op": "set", "path": "dealEscrows/99999999999999999999999999999999/actions/fund_0", "data": { "action": "fund", "actor": "$Sponsor", "expectedVersion": 0, "at": 1800000000 } },
