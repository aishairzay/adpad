      "op": "expect",
      "not": "get(/listingImages/acct_image_owner/files/svg).size > 0 && get(/listingImages/acct_image_owner/files/svg).size <= 5242880 && (get(/listingImages/acct_image_owner/files/svg).contentType == 'image/jpeg' || get(/listingImages/acct_image_owner/files/svg).contentType == 'image/png' || get(/listingImages/acct_image_owner/files/svg).contentType == 'image/webp' || get(/listingImages/acct_image_owner/files/svg).contentType == 'image/avif')"
    },
