    },
    {
      "op": "expect",
      "not": "get(/listingImages/acct_image_owner/files/html).size > 0 && get(/listingImages/acct_image_owner/files/html).size <= 5242880 && (get(/listingImages/acct_image_owner/files/html).contentType == 'image/jpeg' || get(/listingImages/acct_image_owner/files/html).contentType == 'image/png' || get(/listingImages/acct_image_owner/files/html).contentType == 'image/webp' || get(/listingImages/acct_image_owner/files/html).contentType == 'image/avif')"
