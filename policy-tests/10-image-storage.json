{
  "version": "1",
  "name": "Image uploads require account ownership; only persisted image MIME and 1 byte through 5 MiB metadata is publicly readable; bytes remain immutable",
  "actors": {
    "Owner": { "id": "acct_image_owner", "address": "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA", "x": { "id": "9001", "handle": "owner" } },
    "Other": { "id": "acct_image_other", "address": "So11111111111111111111111111111111111111112", "x": { "id": "9002", "handle": "other" } }
  },
