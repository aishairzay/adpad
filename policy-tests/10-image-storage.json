    {
      "op": "set",
      "path": "listingImages/acct_image_owner/files/other_owner",
      "data": {
        "contentType": "image/png",
        "size": 1024
      },
      "shouldFail": true
    },
    {
      "op": "expect",
      "expr": "get(/listingImages/acct_image_owner/files/png).size == 1024"
    },
    {
      "op": "set",
      "path": "listingImages/acct_image_owner/files/png",
      "data": {
        "contentType": "image/png",
        "size": 2048
      },
      "shouldFail": true
    },
