      "op": "as",
      "who": "Other"
    },
    {
      "op": "delete",
      "path": "listingImages/acct_image_owner/files/svg",
      "shouldFail": true
    },
    {
      "op": "delete",
      "path": "listingImages/acct_image_owner/files/oversize",
      "shouldFail": true
