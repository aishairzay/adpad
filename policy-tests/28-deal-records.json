{
  "version": "1",
  "name": "Deal records: only the agent writes the public outcome, and it must match the sponsor deal and its escrow",
  "actors": {
    "Sponsor": { "id": "So11111111111111111111111111111111111111112", "address": "So11111111111111111111111111111111111111112", "x": { "id": "9001", "handle": "sponsor" } },
    "Creator": { "id": "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA", "address": "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA", "x": { "id": "9002", "handle": "creator" } },
    "Outsider": { "id": "11111111111111111111111111111111", "address": "11111111111111111111111111111111", "x": { "id": "9003", "handle": "outsider" } },
    "Agent": { "id": "B9bQJmvkY6mL9HcRkqkP3eMahbgzgentzhpXC7MoDXrx", "address": "B9bQJmvkY6mL9HcRkqkP3eMahbgzgentzhpXC7MoDXrx", "x": { "id": "9004", "handle": "agent" } }
  },
  "steps": [
    { "op": "setTime", "epoch": 1800000000 },
    { "op": "mock", "function": "@AccountPlugin.createAccount", "returns": true },
    { "op": "mock", "function": "@TokenPlugin.transfer", "returns": true },
    { "op": "mock", "function": "@TokenPlugin.getBalance", "returns": 1000000000000 },
    { "op": "as", "who": "Creator" },
    { "op": "set", "path": "listings/l1", "data": { "owner": "$Creator", "seller": "$Creator", "publisher": "Creator", "title": "Hat at Breakpoint", "category": "Event", "channel": "Breakpoint", "description": "I wear sponsor clothing at events.", "deliverables": "Three photos on X.", "audience": "Solana builders", "priceMicro": 50000000, "turnaroundDays": 7, "active": true, "createdAt": 1800000000, "kind": "placement" } },
    { "op": "as", "who": "Sponsor" },
    { "op": "set", "path": "sponsorDeals/deal_ffffffffffffffffffffffffffffffff", "data": { "sponsor": "$Sponsor", "sponsorId": "$Sponsor", "creator": "$Creator", "listingId": "l1", "headline": "Hat at Breakpoint", "brief": "Wear the hat all day and post three photos.", "amountUsdc": 50000000, "challengeSeconds": 86400, "expiresAt": 1801814400, "deadline": 1800604800, "createdAt": 1800000000, "status": "awaiting_funding" } },
    { "op": "as", "who": "Agent" },
    { "op": "set", "path": "dealRecords/deal_ffffffffffffffffffffffffffffffff", "data": { "listingId": "l1", "creator": "$Creator", "sponsor": "$Sponsor", "headline": "Hat at Breakpoint", "amountUsdc": 50000000, "escrowId": "ffffffffffffffffffffffffffffffff", "status": "funded", "updatedAt": 1800000000 }, "shouldFail": true },
    { "op": "as", "who": "Sponsor" },
    { "op": "set", "path": "dealEscrows/ffffffffffffffffffffffffffffffff", "data": { "funder": "$Sponsor", "payee": "$Creator", "amountUsdc": 50000000, "expiresAt": 1801814400, "ref": "deal_ffffffffffffffffffffffffffffffff", "createdAt": 1800000000, "status": "unfunded", "version": 0 } },
    { "op": "set", "path": "sponsorDeals/deal_ffffffffffffffffffffffffffffffff", "data": { "escrowId": "ffffffffffffffffffffffffffffffff", "rootAppId": "68652cfd2a7212f59461a789" } },
    { "op": "as", "who": "Agent" },
    { "op": "set", "path": "dealRecords/deal_ffffffffffffffffffffffffffffffff", "data": { "listingId": "l1", "creator": "$Creator", "sponsor": "$Sponsor", "headline": "Hat at Breakpoint", "amountUsdc": 50000000, "escrowId": "ffffffffffffffffffffffffffffffff", "status": "funded", "updatedAt": 1800000000 }, "shouldFail": true },
    { "op": "as", "who": "Sponsor" },
    { "op": "set", "path": "dealEscrows/ffffffffffffffffffffffffffffffff/actions/fund_0", "data": { "action": "fund", "actor": "$Sponsor", "expectedVersion": 0, "at": 1800000000 } },
    { "op": "as", "who": "Agent" },
    { "op": "set", "path": "sponsorDeals/deal_ffffffffffffffffffffffffffffffff", "data": { "status": "funded" } },
    { "op": "as", "who": "Sponsor" },
    { "op": "set", "path": "dealRecords/deal_ffffffffffffffffffffffffffffffff", "data": { "listingId": "l1", "creator": "$Creator", "sponsor": "$Sponsor", "headline": "Hat at Breakpoint", "amountUsdc": 50000000, "escrowId": "ffffffffffffffffffffffffffffffff", "status": "funded", "updatedAt": 1800000000 }, "shouldFail": true },
    { "op": "as", "who": "Agent" },
    { "op": "set", "path": "dealRecords/deal_ffffffffffffffffffffffffffffffff", "data": { "listingId": "l1", "creator": "$Creator", "sponsor": "$Sponsor", "headline": "Hat at Breakpoint", "amountUsdc": 1000000, "escrowId": "ffffffffffffffffffffffffffffffff", "status": "funded", "updatedAt": 1800000000 }, "shouldFail": true },
    { "op": "set", "path": "dealRecords/deal_ffffffffffffffffffffffffffffffff", "data": { "listingId": "l1", "creator": "$Creator", "sponsor": "$Sponsor", "headline": "Hat at Breakpoint", "amountUsdc": 50000000, "escrowId": "ffffffffffffffffffffffffffffffff", "status": "released", "settledAt": 1800000000, "updatedAt": 1800000000 }, "shouldFail": true },
    { "op": "set", "path": "dealRecords/deal_ffffffffffffffffffffffffffffffff", "data": { "listingId": "l1", "creator": "$Creator", "sponsor": "$Sponsor", "headline": "Hat at Breakpoint", "amountUsdc": 50000000, "escrowId": "ffffffffffffffffffffffffffffffff", "status": "funded", "fundedAt": 1800000000, "updatedAt": 1800000000 } },
    { "op": "expect", "expr": "get(/dealRecords/deal_ffffffffffffffffffffffffffffffff).status == 'funded'" },
    { "op": "as", "who": "Creator" },
    { "op": "set", "path": "dealEscrows/ffffffffffffffffffffffffffffffff/actions/accept_1", "data": { "action": "accept", "actor": "$Creator", "expectedVersion": 1, "at": 1800000000 } },
    { "op": "set", "path": "sponsorDeals/deal_ffffffffffffffffffffffffffffffff", "data": { "status": "proof_submitted", "proofUrl": "https://example.com/proof", "proofAt": 1800000000 } },
    { "op": "as", "who": "Agent" },
    { "op": "set", "path": "sponsorDeals/deal_ffffffffffffffffffffffffffffffff", "data": { "status": "released", "settledAt": 1800000000 }, "shouldFail": true },
    { "op": "as", "who": "Sponsor" },
    { "op": "set", "path": "dealEscrows/ffffffffffffffffffffffffffffffff/actions/release_2", "data": { "action": "release", "actor": "$Sponsor", "expectedVersion": 2, "at": 1800000000 } },
    { "op": "as", "who": "Agent" },
    { "op": "set", "path": "dealRecords/deal_ffffffffffffffffffffffffffffffff", "data": { "status": "funded", "updatedAt": 1800000000 }, "shouldFail": true },
    { "op": "set", "path": "sponsorDeals/deal_ffffffffffffffffffffffffffffffff", "data": { "status": "released", "settledAt": 1800000000, "verdict": "release", "verdictReason": "Matches the brief." } },
    { "op": "set", "path": "dealRecords/deal_ffffffffffffffffffffffffffffffff", "data": { "status": "released", "settledAt": 1800000000, "proofUrl": "https://example.com/other", "updatedAt": 1800000000 }, "shouldFail": true },
    { "op": "set", "path": "dealRecords/deal_ffffffffffffffffffffffffffffffff", "data": { "status": "refunded", "settledAt": 1800000000, "updatedAt": 1800000000 }, "shouldFail": true },
    { "op": "set", "path": "dealRecords/deal_ffffffffffffffffffffffffffffffff", "data": { "status": "released", "settledAt": 1800000000, "proofUrl": "https://example.com/proof", "updatedAt": 1800000000 } },
    { "op": "expect", "expr": "get(/dealRecords/deal_ffffffffffffffffffffffffffffffff).status == 'released'" },
    { "op": "as", "who": "Outsider" },
    { "op": "expect", "expr": "get(/dealRecords/deal_ffffffffffffffffffffffffffffffff).proofUrl == 'https://example.com/proof'" },
    { "op": "delete", "path": "dealRecords/deal_ffffffffffffffffffffffffffffffff", "shouldFail": true }
  ]
}
