    {"op": "as", "who": "Sponsor"},
    {"op": "set", "path": "dealEscrows/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "data": {"funder": "$Sponsor", "amountUsdc": 50000000, "expiresAt": 1800864000, "ref": "deal_eeeeeeee", "createdAt": 1800000000, "status": "unfunded", "version": 0, "payee": "$Creator"}},
    {"op": "set", "path": "dealEscrows/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee/actions/fund_sponsor_52", "data": {"action": "fund", "actor": "$Sponsor", "expectedVersion": 0, "at": 1800000000}},
    {"op": "as", "who": "Creator"},
